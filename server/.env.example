FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# AI Classification
ANTHROPIC_API_KEY="sk-ant-api03-..."

# Email (Resend)
RESEND_API_KEY="re_..."

# CORS
CORS_ORIGIN="http://localhost:3000"

# Server
PORT=4000
NODE_ENV=development
