# ═══ FIREBASE CLIENT (public) ═══
# Get from Firebase Console → Project Settings → Your apps → Config
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ═══ FIREBASE ADMIN (server-only) ═══
# Get from Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your-service-account@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ═══ EMAIL NOTIFICATIONS ═══
# Get from Resend: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# ═══ GMAIL (For Payment Alerts) ═══
# Gmail address for sending alerts
GMAIL_USER=your-email@gmail.com
# Generate app password: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# ═══ AI (Optional) ═══
# Get from Anthropic Console: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk_your_anthropic_api_key_here

# ═══ AUTHENTICATION & IDENTITY (Required for user auth) ═══
# Generate a random 32-byte string for JWT signing (use: openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_here_change_in_production

# Generate a random encryption key for DID private key encryption (use: openssl rand -base64 32)
DID_ENCRYPTION_KEY=your_did_encryption_key_here_change_in_production

# ═══ SUPABASE (Optional) ═══
# Get from Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your_project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ═══ ZKSYNC (Optional) ═══
# Public RPC URLs (no auth needed, but rate-limited)
NEXT_PUBLIC_ZKSYNC_RPC_URL=https://sepolia.era.zksync.dev

# ═══ DATABASE ═══
# Local SQLite path (auto-created if not exists)
DATABASE_URL=file:./data/fixmypayments.db
